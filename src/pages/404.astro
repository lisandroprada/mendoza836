---
import '../styles/global.css';
import { whatsapp } from '../data';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página no encontrada | Mendoza 836</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="sec sec--azul" style="min-height:100vh;display:grid;place-items:center">
      <div class="wrap">
        <h1 style="font-size:var(--t-h2)">Esta página no existe</h1>
        <p class="lead">Volvé a la casa o escribinos por WhatsApp.</p>
        <p style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn" href="/">Ir a Mendoza 836</a>
          <a class="btn" href={whatsapp} target="_blank" rel="noopener">Consultar por WhatsApp</a>
        </p>
      </div>
    </main>
  </body>
</html>
